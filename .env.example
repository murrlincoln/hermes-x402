# Bridge port (default 8402)
X402_BRIDGE_PORT=8402

# Override config dir (default ~/.hermes-x402)
# X402_HOME=

# Override Venice API base URL (default https://api.venice.ai)
# VENICE_API_URL=https://api.venice.ai

# Auto top-up: if set, bridge will auto-fund on 402 with this USDC amount
# Leave blank for the "real metabolism" experiment — wallet dies when empty.
# X402_AUTO_TOPUP_USDC=
